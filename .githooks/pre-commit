#!/usr/bin/env bash
# Committed pre-commit hook. Enable once with:  git config core.hooksPath .githooks
# Runs the repo architecture gate (the same ast-grep rules the Claude PreToolUse
# hook enforces, applied to the whole tree, + cross-file structural checks)
# so EVERY commit — human or agent — is gated, not just Claude's edits.
# CI runs the identical gate (ci.yml) so this cannot be bypassed by skipping the hook.
set -u
repo="$(git rev-parse --show-toplevel)"
gate="$repo/.claude/hooks/rules/ci-gate.sh"
[ -x "$gate" ] || { echo "pre-commit: gate script missing ($gate)"; exit 1; }
# The gate judges the working tree, not the index this hook was handed, and several of its steps
# build scratch repositories (the hook-policy suites, the gate fixtures). Under a hook in a linked
# worktree, git exports GIT_DIR and GIT_INDEX_FILE as absolute paths into .git/worktrees/<name>.
# When scratch `git init` / `git -C <tmp> config` calls inherited them, they rewrote the shared
# .git/config (core.bare=true, user.name=t, 2026-09-23). Dropping git's repository-local variables
# once, here, means every step the gate runs, now or later, starts the way it does in CI: from the
# working tree, with nothing pointing at this repository. Test:
# .claude/hooks/tests/test_pre_commit_git_env.py.
# shellcheck disable=SC2046 # one variable name per word is the point
unset $(git rev-parse --local-env-vars)
exec bash "$gate"
