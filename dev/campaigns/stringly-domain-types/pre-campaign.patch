diff --git a/.rules/kotlin/ast-grep/rules-style/no-deprecated-without-version.yaml b/.rules/kotlin/ast-grep/rules-style/no-deprecated-without-version.yaml
index 410a8f7..ab175ae 100644
--- a/.rules/kotlin/ast-grep/rules-style/no-deprecated-without-version.yaml
+++ b/.rules/kotlin/ast-grep/rules-style/no-deprecated-without-version.yaml
@@ -2,18 +2,14 @@ id: no-deprecated-without-version
 language: kotlin
 severity: warning
 message: "`@Deprecated` message doesn't mention a version. Without a version, consumers can't tell how urgent the migration is or when the symbol will be removed. Mention the version it was deprecated in and/or the version it will be removed in, e.g. `@Deprecated(\"Use X instead, removed in 2.0.0\")`."
+# Bind only the first deprecation argument (the message). A relational stopBy:end walk
+# previously matched ANY nested string — including ReplaceWith("newApi()") — so a
+# compliant declaration still warned. Pattern metavariable $MESSAGE is the first arg only.
 rule:
-  kind: annotation
-  all:
-    - has: { kind: user_type, stopBy: end, has: { kind: type_identifier, regex: '^Deprecated$' } }
-    - has:
-        kind: value_arguments
-        stopBy: end
-        has:
-          kind: value_argument
-          has:
-            kind: string_literal
-            not:
-              has:
-                kind: string_content
-                regex: '(?i)(version|\d+\.\d+)'
+  any:
+    - pattern: '@Deprecated($MESSAGE)'
+    - pattern: '@Deprecated($MESSAGE, $$$REST)'
+constraints:
+  MESSAGE:
+    not:
+      regex: '(?i)(version|\d+\.\d+)'
diff --git a/.rules/kotlin/ast-grep/rules-style/no-public-without-since.yaml b/.rules/kotlin/ast-grep/rules-style/no-public-without-since.yaml
index ad95977..234346d 100644
--- a/.rules/kotlin/ast-grep/rules-style/no-public-without-since.yaml
+++ b/.rules/kotlin/ast-grep/rules-style/no-public-without-since.yaml
@@ -2,6 +2,8 @@ id: no-public-without-since
 language: kotlin
 severity: warning
 message: "Public declaration has no KDoc `@since` tag (either no KDoc at all, or a KDoc missing `@since`). This is a published, ABI-validated library — consumers and changelog tooling rely on `@since` to know which release introduced a symbol. Add a `/** ... @since X.Y.Z */` block directly above the declaration."
+# Require the KDoc opening token (`/**`). A plain block comment `/* @since ... */` is NOT
+# published by Dokka, so accepting any multiline_comment let non-KDoc markers slip through.
 rule:
   all:
     - any:
@@ -15,4 +17,4 @@ rule:
     - not:
         follows:
           kind: multiline_comment
-          regex: '@since'
+          regex: '^/\*\*[\s\S]*@since'
diff --git a/CHANGELOG.md b/CHANGELOG.md
index aafcef1..a7bc4c4 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -6,6 +6,35 @@ This project follows Semantic Versioning once the first stable release is cut.
 
 ## Unreleased
 
+- **PR review follow-ups (release hardening):**
+  - **Security:** `issue-triage.yml` no longer interpolates `workflow_dispatch` input
+    into Bash source; the issue number is passed via `env` and validated as decimal.
+  - **Wire:** `ToolResultOutput.Json.toJsonElement()` now emits a `type=json` envelope
+    (matching the existing decoder), so a success payload that collides with an
+    error/denial shape cannot be re-decoded as `Error`.
+  - **Provider registry:** `ModelRef` resolution on `ProviderRegistry` dispatches from
+    the typed `providerId`/`modelId` components and no longer re-stringifies through
+    colon-hardcoded `qualifiedName` (custom separators work on the typed path).
+  - **MCP stdio:** `start()` failure after `begin()` (including cancellation during a
+    stale-process close) finishes teardown under `NonCancellable`, clears the process
+    field, and resets the lifecycle before rethrowing.
+  - **IDs:** Google Interactions / Google Language Model / Bedrock Mantle ID-less
+    fallbacks use the injected `generateId` callback instead of the global
+    `GenerateId()`.
+  - **Gateway:** blank `VERCEL_OIDC_TOKEN` is treated as absent (same as blank API key).
+  - **Mock:** `ScriptedResponse` is `@Poko` + internal constructor + DSL factory
+    (no public `data class` / `copy`); data-class budget ratcheted 40 → 39.
+  - **Triage:** `classify.sh` partitions labels into at most one type + two areas.
+  - **Rules:** `no-deprecated-without-version` binds only the message argument
+    (ReplaceWith strings no longer false-positive); `no-public-without-since` requires
+    a real KDoc `/**` opener.
+  - **Open Responses:** unknown provider-tool types still passthrough for forward-compat
+    but now emit a local `CallWarning("unsupported", …)` so a typo'd `providerToolId`
+    does not look like a remote 4xx outage.
+  - **KDoc:** `ProviderId`/`ModelId`/`ToolCallId`/`ToolName`/`ApprovalId` companion
+    `invoke` factories tagged `@since 0.3.0-beta01` alongside their `of()` siblings.
+  - **Bugfix:** `ModelRef(providerId, modelId)` factory no longer recurses into itself.
+
 - **Breaking (source):** every public `companion object` factory moved to a top-level
   declaration, completing the `no-companion-objects` migration. The capabilities are
   unchanged — only the call syntax moves — and the committed ABI dumps now record it.
